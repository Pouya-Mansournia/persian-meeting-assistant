{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jalaseh",
  "version": "0.1.0",
  "identifier": "com.jalaseh.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "externalBin": [
      "binaries/jalaseh-backend"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "macOS": {
      "minimumSystemVersion": "27.0",
      "entitlements": "Entitlements.plist"
    },
    "shortDescription": "Private Persian meeting notes",
    "category": "Productivity"
  }
}
